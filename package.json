{
  "name": "iron-vault",
  "version": "0.48.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "vite preview",
    "typecheck": "tsc",
    "test": "node --experimental-strip-types --no-warnings --loader ./tests/ts-loader.mjs --test tests/*.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write app lib tests scripts/*.mjs",
    "format:check": "prettier --check app lib tests scripts/*.mjs",
    "check": "npm run typecheck && npm run lint && npm test && vite build"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@napi-rs/canvas": "^1.0.13",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  },
  "type": "module",
  "description": "IRON VAULT – 3D-Mech-Pilotenkanzel im Browser (Three.js + React + Vite)"
}
