{
  "name": "iron-vault",
  "version": "0.57.0",
  "private": true,
  "description": "IRON VAULT – 3D-Mech-Pilotenkanzel (Three.js + React + Vite), im Browser oder als Desktop-App",
  "author": "Rene",
  "main": "electron/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "vite preview",
    "typecheck": "tsc",
    "test": "node --experimental-strip-types --no-warnings --loader ./tests/ts-loader.mjs --test tests/*.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write app lib tests scripts/*.mjs",
    "format:check": "prettier --check app lib tests scripts/*.mjs",
    "check": "npm run typecheck && npm run lint && npm test && vite build",
    "app": "vite build && electron .",
    "dist:linux": "tsc && vite build && electron-builder --linux AppImage --publish never"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@napi-rs/canvas": "^1.0.13",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lucide-react": "^1.31.0",
    "prettier": "^3.9.10",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.35.5",
    "three": "^0.185.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "de.rene.ironvault",
    "productName": "IRON VAULT",
    "executableName": "iron-vault",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "synopsis": "3D-Mech-Pilotenkanzel IV-04",
      "artifactName": "IRON_VAULT-${version}-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "IRON VAULT",
          "Comment": "Pilotenkanzel des Mechs IV-04"
        }
      },
      "syncDesktopName": true
    },
    "publish": null
  },
  "desktopName": "iron-vault.desktop"
}
